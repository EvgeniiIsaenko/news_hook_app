@model IEnumerable<NewsHook_Web.Models.DataBase.User>

<div class="container mt-4">
    <div class="row">
        <div class="col-md-6">
            <h2 style="color: white">Список пользователей</h2>
        </div>
        <div class="col-md-6 text-end">
            <a asp-action="Register" class="btn btn-primary" style="background-color: red; color: white; border-color: white"><i class="bi bi-plus-circle"></i> Добавить</a>
        </div>
    </div>

    <table class="table mt-3">
        <thead>
            <tr>
                <th style="background-color: rgba(20, 22, 24, 1); color: white">Имя пользователя</th>
                <th style="background-color: rgba(20, 22, 24, 1); color: white">Действие</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td style="background-color: rgba(20, 22, 24, 1); color: white">@Html.DisplayFor(modelItem => item.Login)</td>
                    <td style="background-color: rgba(20, 22, 24, 1); color: white">
                        @if (item.Login != "root_user")
                        {
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger"><i class="bi bi-trash"></i> Удалить</a>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
