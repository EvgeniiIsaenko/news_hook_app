@model IEnumerable<NewsHook_Web.Models.DataBase.MediaLink>
@{
    ViewData["Title"] = "Media";
}

<div class="container mt-4" style="color: white">
    <div class="row">
        <div class="col-md-6">
            <h2 style="color: white">Медиа</h2>
        </div>
        @if (Context.Session.GetString("Login") is not null)
        {
            <div class="col-md-6 text-end" >
                <a asp-controller="constructor" class="btn btn-primary" style="background-color: red; color: white; border-color: white"><i class="bi bi-plus-circle"></i> Добавить</a>
            </div>
        }
    </div>

    <table class="table mt-3" style="">
        <thead >
            <tr style="color: white">
                <th style="background-color: rgba(20, 22, 24, 1); color: white">Имя</th>
                <th style="background-color: rgba(20, 22, 24, 1); color: white">URL</th>
                @if (Context.Session.GetString("Login") is not null)
                {
                    <th style="background-color: rgba(20, 22, 24, 1); color: white">Событие</th>
                }
            </tr>
        </thead>
        <tbody style="color: white">
            @foreach (var item in Model)
            {
                <tr>
                    <td style="background-color: rgba(20, 22, 24, 1); color: white">@Html.DisplayFor(modelItem => item.Name)</td>
                    <td style="background-color: rgba(20, 22, 24, 1); color: white"><a href="@item.Url" target="_blank">@Html.DisplayFor(modelItem => item.Url)</a></td>
                    @if (Context.Session.GetString("Login") is not null)
                    {
                        <td style="background-color: rgba(20, 22, 24, 1); color: white">
                            <a asp-controller="constructor" asp-action="media" asp-route-id="@item.Id" class="btn btn-primary" style="background-color: red; color: white; border-color: white"><i class="bi bi-pencil"></i> Изменить</a>
                        </td>
                    }
                </tr>
            }
        </tbody>
    </table>

</div>
