@model NewsHook_Web.Models.DataBase.User

@{
    ViewData["Title"] = "Login";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    body {
        background-color: #f2fafe;
    }

    .card {
        box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
        margin-top: 20px;
    }

    .btn-login {
        margin-top: 15px;
    }

    .form-group {
        margin-bottom: 15px;
    }

</style>

<body>
    <div class="container mt-5">
        <div class="row justify-content-center">
            <div class="col-md-6">
                <div class="card" style="background-color: rgba(20, 22, 24, 1); color: white">
                    <div class="card-header">
                        <h1 class="text-center" style="color: white">Вход</h1>
                    </div>
                    <div class="card-body">
                        <form asp-action="Login">
                            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                            <div class="form-group">
                                <label asp-for="Login" class="control-label" style="color:white">Имя пользователя:</label>
                                <input asp-for="Login" class="form-control" />
                                <span asp-validation-for="Login" class="text-danger"></span>
                            </div>
                            <div class="form-group">
                                <label asp-for="Password" class="control-label" style="color: white">Пароль:</label>
                                <input asp-for="Password" type="password" class="form-control" />
                                <span asp-validation-for="Password" class="text-danger"></span>
                            </div>
                            <div class="form-group">
                                <button type="submit" class="btn btn-primary btn-block btn-login" style="background-color: red; color: white; border-color: white">Войти</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>

        <div class="row mt-3">
            <div class="col text-center">
                <a asp-controller="Home" asp-action="Index" >Вернуться</a>
            </div>
        </div>
    </div>
</body>

@section Scripts
    {
    <partial name="_ValidationScriptsPartial" />
}
